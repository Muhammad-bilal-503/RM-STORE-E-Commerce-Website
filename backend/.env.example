# Server
NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string
# Get this from Atlas -> Database -> Connect -> Drivers
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/rm-store?retryWrites=true&w=majority

# Auth
JWT_SECRET=replace_with_a_long_random_string

# Frontend URLs — used to build links in emails (verification/reset)
CLIENT_URL=http://localhost:3000
# Comma-separated list of allowed origins for CORS (customer + admin frontends)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Email (SMTP) — used for verification & password-reset emails.
# If left unset, emails are logged to the console instead of sent (dev fallback).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password
EMAIL_FROM=your_email@gmail.com

# Stripe
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
